# Pinata IPFS credentials
# Get these from https://app.pinata.cloud/keys

# Option 1 – JWT (recommended)
PINATA_JWT=

# Option 2 – API Key + Secret
PINATA_API_KEY=
PINATA_API_SECRET=

# ── Smart contract deployment ─────────────────────────────────────────────
# Private key of the deployer wallet (WITHOUT 0x prefix is also accepted)
PRIVATE_KEY=

# Base Mainnet RPC (default: https://mainnet.base.org)
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia Testnet RPC (default: https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Basescan API key for contract verification
# Get from: https://basescan.org/apis
BASESCAN_API_KEY=

# ── Base Mini App ─────────────────────────────────────────────────────────────
# App ID registered at https://onchainsummer.xyz / Coinbase Developer Platform
NEXT_PUBLIC_BASE_APP_ID=
