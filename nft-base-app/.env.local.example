# ── NFT contract ─────────────────────────────────────────────────────────────
# Address of the deployed NFTCollection contract (Base or Base Sepolia)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Chain ID: 8453 = Base Mainnet, 84532 = Base Sepolia
NEXT_PUBLIC_CHAIN_ID=84532

# ── Backend API ───────────────────────────────────────────────────────────────
# URL of the running FastAPI server (nft-base-app/backend/server.py)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI server.
# Defaults to http://localhost:3000. Set this in the backend's env, not here.
# CORS_ORIGINS=https://your-dapp.com
